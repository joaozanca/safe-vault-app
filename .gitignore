# Node / JS
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Expo / React Native
# android/ e ios/ NÃO são versionados de propósito: são gerados por `npx expo
# prebuild` a partir do app.json e dos config plugins (Continuous Native
# Generation). Customização nativa entra no app.json/plugins, nunca editando
# essas pastas na mão — senão a próxima geração apaga a edição.
.expo/
dist/
web-build/
expo-env.d.ts
*.orig.*
/android/
/ios/
.kotlin/
.metro-health-check*
*.tsbuildinfo
*.keystore
!debug.keystore

# Detox
artifacts/
e2e/artifacts/

# Appium / Allure / relatorios de teste
allure-results/
allure-report/
.pytest_cache/
__pycache__/
*.py[cod]

# Python virtualenv
.venv/
venv/

# Segredos e dados reais do cofre (NUNCA versionar)
*.env
.env*
!.env.example
*.safevault
*.vaultbackup
secrets/
local/

# IDE / SO
.idea/
.vscode/
.DS_Store
Thumbs.db
