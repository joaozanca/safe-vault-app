diff --git a/node_modules/react-native-libsodium/android/CMakeLists.txt b/node_modules/react-native-libsodium/android/CMakeLists.txt
index aea3c38..aad2c9f 100644
--- a/node_modules/react-native-libsodium/android/CMakeLists.txt
+++ b/node_modules/react-native-libsodium/android/CMakeLists.txt
@@ -1,5 +1,14 @@
 cmake_minimum_required(VERSION 3.4.1)
 
+# [patch-package] NODE_MODULES_DIR chega com barra invertida no Windows
+# (ex.: C:\Users\...) porque o build.gradle passa o caminho nativo direto.
+# Dentro de string entre aspas, o CMake interpreta "\U" como início de um
+# escape Unicode de 8 dígitos hex — e "C:\Users\..." tem exatamente essa
+# sequência, então qualquer uso de ${NODE_MODULES_DIR} numa string quebra
+# com "Invalid character escape '\U'". file(TO_CMAKE_PATH) normaliza para
+# barra normal antes de qualquer outro uso da variável.
+file(TO_CMAKE_PATH "${NODE_MODULES_DIR}" NODE_MODULES_DIR)
+
 set (CMAKE_VERBOSE_MAKEFILE ON)
 set (CMAKE_CXX_STANDARD 20)
 
